# Clés des API gratuites utilisées par scripts/actualiser_marches.py.
# Pour un essai sur ton ordinateur : copie ce fichier en « .env » (jamais envoyé sur GitHub) et remplis les valeurs.
# Sur GitHub : ajoute les mêmes noms dans Settings → Secrets and variables → Actions.
# Une clé absente n'est pas une erreur : la source correspondante est simplement sautée.

# NewsData.io, actualités (principale) : https://newsdata.io/register
NEWSDATA_KEY=

# MarketAux, actualités (secours) : https://www.marketaux.com/register
MARKETAUX_KEY=
